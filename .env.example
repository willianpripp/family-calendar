# Copy to .env on the host (mode 600) and set a real password. The .env never
# enters git; the deploy creates it once and rsync (no --delete) leaves it alone.
CAL_DB_PASSWORD=change-me
# Optional overrides, defaults shown:
# CAL_DB_NAME=calendar
# CAL_DB_USER=calendar
# CAL_TZ=America/New_York
# Free key from https://www.themoviedb.org/settings/api — fills the
# "out this month" movies/series rail. Optional; the calendar works without it.
# CAL_TMDB_KEY=
# Whose device is whose, so each person sees their own background pictures with
# no login. Addresses come from `tailscale status`; /who in the app reports the
# address it actually saw. Cosmetic only: an unlisted device gets the shared set.
# CAL_DEVICES=100.101.102.1=willian,100.101.102.2=aline
# The login for visitors arriving from the public internet (Tailscale Funnel).
# Tailnet and home-LAN devices never see it. Secret: any long random string
# (`openssl rand -hex 32`). Users: name=hash pairs, hash minted by
# `python app/gate.py 'the-password'`.
# CAL_GATE_SECRET=
# CAL_GATE_USERS=willian=pbkdf2:600000:...:...,aline=pbkdf2:600000:...:...
