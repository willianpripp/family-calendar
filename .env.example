# Copy to .env on the host (mode 600) and set a real password. The .env never
# enters git; the deploy creates it once and rsync (no --delete) leaves it alone.
CAL_DB_PASSWORD=change-me
# Optional overrides, defaults shown:
# CAL_DB_NAME=calendar
# CAL_DB_USER=calendar
# CAL_TZ=America/New_York
# Free key from https://www.themoviedb.org/settings/api — fills the
# "out this month" movies/series rail. Optional; the calendar works without it.
# CAL_TMDB_KEY=
